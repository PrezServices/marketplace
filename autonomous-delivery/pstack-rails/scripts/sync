#!/usr/bin/env bash
# Usage: sync [repo...] | sync --branch <repo>
# Puts each submodule folder (all of them by default) on its configured branch, fast-forwarded to origin's
# latest commit. The branch is submodule.<name>.branch in .gitmodules, main when unset. A folder that is not
# cloned yet is cloned; a folder that is already cloned is never moved to the commit the workspace records.
# `--branch <repo>` prints that repo's configured branch and syncs nothing.
# Run it from the workspace root: the root is the git repo of the current directory, not of this script.
# Exit: 0 all synced; 2 some skipped (each named on stderr); any other non-zero is a hard failure
# (unknown repo, clone or fetch error) and stops at that repo. A skip is a folder git would not clone
# (update = none), one with local changes, one on a detached HEAD whose commits no branch holds, one that
# would not switch to its branch, or one whose branch has diverged from origin's. Skips are listed in
# report below.
set -euo pipefail

root="$(git rev-parse --show-toplevel)"

# The one place a repo's outcome becomes a line, a stream and (through $skipped) the exit status.
report() {
  case "$1" in
    synced)    echo "$repo: $branch at $(git -C "$dir" rev-parse --short HEAD)" ;;
    notcloned) echo "$repo: not cloned, skipped" >&2 ;;
    dirty)     echo "$repo: has local changes, skipped" >&2 ;;
    nobranch)  echo "$repo: has commits on no branch, skipped" >&2 ;;
    noswitch)  echo "$repo: could not switch to $branch, skipped" >&2 ;;
    diverged)  echo "$repo: $branch has diverged from origin/$branch, left as is" >&2 ;;
  esac
  [ "$1" = synced ] || skipped=1
}

# "submodule.<name>.path <path>" lines. Exit 1 from git only means none are configured.
submodule_paths() {
  [ -f "$root/.gitmodules" ] || return 0
  local status=0
  git -C "$root" config -f .gitmodules --get-regexp '^submodule\..*\.path$' || status=$?
  [ "$status" -le 1 ] || exit "$status"
}

# The submodule name for a path; empty when the path is not a submodule.
name_of() {
  printf '%s\n' "$paths" | awk -v path="$1" '$2 == path { sub(/^submodule\./, "", $1); sub(/\.path$/, "", $1); print $1; exit }'
}

# True when $dir is a repo of its own. A folder git left empty (update = none) is not one, and git -C on
# it acts on the workspace repo, so no git call touches a folder before this holds.
own_repo() {
  local top
  top="$(git -C "$dir" rev-parse --show-toplevel 2>/dev/null)" && [ "$top" = "$(cd "$dir" && pwd -P)" ]
}

# The branch a submodule follows. Git keys it by the submodule's name, which is not always its path.
configured_branch() {
  git -C "$root" config -f .gitmodules --default main --get "submodule.$(name_of "$1").branch"
}

paths="$(submodule_paths)"

branch_only=0
if [ "${1:-}" = --branch ]; then
  [ $# -eq 2 ] || { echo "usage: sync --branch <repo>" >&2; exit 1; }
  branch_only=1
  shift
fi

if [ $# -eq 0 ]; then
  # shellcheck disable=SC2046
  set -- $(printf '%s\n' "$paths" | awk '{ print $2 }')
fi

for repo in "$@"; do
  if [ -z "$(name_of "${repo%/}")" ]; then
    echo "error: '$repo' is not a submodule of this workspace" >&2
    exit 1
  fi
done

if [ "$branch_only" -eq 1 ]; then
  configured_branch "${1%/}"
  exit 0
fi

skipped=0
for repo in "$@"; do
  repo="${repo%/}"
  dir="$root/$repo"
  branch="$(configured_branch "$repo")"

  # Only a folder with no .git is cloned: an unusable .git is a skip below, never something to clone over.
  if [ ! -e "$dir/.git" ]; then
    git -C "$root" submodule update --init --quiet "$repo"
  fi
  if ! own_repo; then
    report notcloned
    continue
  fi
  git -C "$dir" fetch --quiet origin

  if [ -n "$(git -C "$dir" status --porcelain)" ]; then
    report dirty
    continue
  fi

  # Switching away from a detached HEAD that no branch holds would leave its commits behind. The commit
  # the workspace records is held by the workspace, so a folder sitting on it has nothing to lose.
  if ! git -C "$dir" symbolic-ref --quiet HEAD >/dev/null &&
     [ "$(git -C "$dir" rev-parse HEAD)" != "$(git -C "$root" rev-parse --verify --quiet "HEAD:$repo")" ] &&
     [ -z "$(git -C "$dir" for-each-ref --count=1 --contains HEAD refs/heads refs/remotes)" ]; then
    report nobranch
    continue
  fi

  if git -C "$dir" show-ref --verify --quiet "refs/heads/$branch"; then
    switch=(switch --quiet "$branch")
  else
    switch=(switch --quiet --track -c "$branch" "origin/$branch")
  fi
  if ! git -C "$dir" "${switch[@]}"; then
    report noswitch
    continue
  fi

  if git -C "$dir" merge --quiet --ff-only "origin/$branch" 2>/dev/null; then
    report synced
  else
    report diverged
  fi
done

[ "$skipped" -eq 0 ] || exit 2
